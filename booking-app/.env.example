# ─── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Encryption (M0) ────────────────────────────────────────────────────────
# Used for AES-256-GCM encryption of PHI/PII at rest (messages, emails, tokens).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_SECRET=

# Optional dedicated key for messaging module; falls back to ENCRYPTION_SECRET.
MESSAGING_ENCRYPTION_KEY=

# Patient portal session signing (M4) — generate a separate random secret.
PORTAL_SECRET=

# ─── Redis / Email Worker ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
SENDGRID_API_KEY=
EMAIL_FROM=

# ─── Integrations ───────────────────────────────────────────────────────────
HIPPATIZER_API_KEY=
HIPPATIZER_WEBHOOK_SECRET=
HIPPATIZER_ENABLED=true

NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# GIGI website chatbot (server-side only — never expose in widget JS)
VAPI_PRIVATE_KEY=
GIGI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=
CHATBOT_CORS_ORIGINS=https://www.kids0218.com,https://kids0218.com,https://kids-0-to-18-integrative-pediatrics.webflow.io,http://localhost:3000
CHATBOT_RATE_LIMIT=30

# ─── Twilio SMS (Phase 2 — M8) ───────────────────────────────────────────────
# REQUIRED: Sign Twilio HIPAA BAA before sending PHI via SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Production security ──────────────────────────────────────────────────────
# Messaging module MUST run over HTTPS in production before go-live.
# Current VPS path uses HTTP — upgrade before storing real message PHI.

# ─── Agenda & patient reminders (docs/agenda) ────────────────────────────────
# Authorises /api/cron/dispatch (Vercel Cron sends it automatically; set the same value as
# "Authorization: Bearer <value>" on the cron-job.org job). Without it nothing is sent.
CRON_SECRET=
# Public base URL used in patient links (/c/<token>) — defaults to NEXTAUTH_URL.
PUBLIC_APP_URL=
# Optional: secret for patient link tokens (defaults to NEXTAUTH_SECRET). Changing it
# invalidates links already sent to patients.
APPOINTMENT_LINK_SECRET=
# Twilio alphanumeric sender (e.g. "NunesMont", max 11 chars) can be used as TWILIO_PHONE_NUMBER
# where the carrier allows it; patients then cannot reply by SMS (they use the link).
