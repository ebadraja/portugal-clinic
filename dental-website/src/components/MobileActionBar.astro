---
import type { Lang } from '../i18n';
import { useTranslations } from '../i18n';
import { site } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const waUrl = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(t.hero.whatsappMessage)}`;
---

<nav
  class="fixed inset-x-0 bottom-0 z-50 border-t border-border bg-white/95 backdrop-blur-md md:hidden"
  aria-label={t.a11y.quickActions}
>
  <div class="grid grid-cols-3">
    <a
      href={`tel:${site.phoneTel}`}
      class="flex min-h-14 flex-col items-center justify-center gap-0.5 py-2 text-[0.7rem] font-semibold text-primary transition-colors active:bg-primary-soft"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M8.5 4.5h2.2l1 4.2-1.7 1a12.5 12.5 0 0 0 5.3 5.3l1-1.7 4.2 1v2.2a1.8 1.8 0 0 1-1.8 1.8A15.7 15.7 0 0 1 3.7 6.3 1.8 1.8 0 0 1 5.5 4.5Z" stroke-linejoin="round" />
      </svg>
      <span>{t.mobileBar.call}</span>
    </a>
    <a
      href={waUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex min-h-14 flex-col items-center justify-center gap-0.5 border-x border-border py-2 text-[0.7rem] font-semibold text-primary transition-colors active:bg-primary-soft"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2a9.9 9.9 0 0 0-8.5 14.9L2 22l5.25-1.38A9.9 9.9 0 1 0 12.04 2Zm5.78 14.1c-.24.68-1.4 1.25-1.94 1.33-.5.07-1.12.1-1.81-.11-.42-.13-.96-.31-1.65-.6-2.9-1.25-4.78-4.17-4.93-4.36-.14-.2-1.2-1.6-1.2-3.05s.76-2.17 1.03-2.47c.27-.3.59-.37.79-.37h.57c.18 0 .42-.07.66.5.24.58.82 2 .89 2.14.07.14.12.3.02.49-.1.2-.15.32-.3.49-.14.17-.3.38-.43.51-.14.14-.29.29-.12.56.16.27.73 1.2 1.56 1.95 1.07.96 1.97 1.26 2.25 1.4.27.14.43.12.59-.07.16-.2.68-.79.86-1.06.18-.27.36-.22.61-.13.24.1 1.54.73 1.8.86.27.14.44.2.51.31.07.11.07.64-.17 1.32Z" />
      </svg>
      <span>{t.mobileBar.whatsapp}</span>
    </a>
    <a
      href={site.mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="flex min-h-14 flex-col items-center justify-center gap-0.5 py-2 text-[0.7rem] font-semibold text-primary transition-colors active:bg-primary-soft"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M12 21s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10Z" stroke-linejoin="round" />
        <circle cx="12" cy="11" r="2.2" />
      </svg>
      <span>{t.mobileBar.directions}</span>
    </a>
  </div>
</nav>
