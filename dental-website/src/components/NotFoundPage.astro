---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import MobileActionBar from './MobileActionBar.astro';
import type { Lang } from '../i18n';
import { localizePath, useTranslations } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t.meta.notFoundTitle} description={t.meta.notFoundDescription}>
  <Header lang={lang} />
  <main id="conteudo" class="section-pad flex min-h-[70vh] items-center pt-28 md:pt-32">
    <div class="container-site max-w-xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent">404</p>
      <h1 class="mt-3 text-3xl text-primary-dark md:text-4xl">{t.notFound.title}</h1>
      <p class="mt-4 text-muted">{t.notFound.body}</p>
      <a
        href={localizePath(lang, '/')}
        class="mt-8 inline-flex min-h-12 items-center justify-center rounded-lg bg-primary px-6 font-semibold text-white transition-colors hover:bg-primary-dark"
      >
        {t.notFound.cta}
      </a>
    </div>
  </main>
  <Footer lang={lang} />
  <MobileActionBar lang={lang} />
</BaseLayout>
