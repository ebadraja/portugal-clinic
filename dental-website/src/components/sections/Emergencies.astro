---
import type { Lang } from '../../i18n';
import { useTranslations } from '../../i18n';
import { site } from '../../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="urgencias" class="section-pad bg-surface" aria-labelledby="urgencias-title">
  <div class="container-site">
    <div class="fade-up overflow-hidden rounded-[var(--radius-card)] border-2 border-emergency/30 bg-emergency-soft">
      <div class="grid items-center gap-6 p-5 sm:gap-8 sm:p-8 md:grid-cols-[1fr_auto] md:p-10 lg:p-12">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.16em] text-emergency">{t.emergencies.eyebrow}</p>
          <h2 id="urgencias-title" class="mt-3 text-2xl text-primary-dark sm:text-3xl md:text-4xl">
            {t.emergencies.title}
          </h2>
          <p class="mt-4 max-w-xl text-muted">{t.emergencies.body}</p>
          <p class="mt-3 max-w-xl text-sm text-muted">{t.emergencies.afterHours}</p>
        </div>
        <div class="text-center md:text-right">
          <a
            href={`tel:${site.phoneTel}`}
            class="inline-flex min-h-14 w-full items-center justify-center rounded-lg bg-emergency px-6 text-xl font-semibold tracking-wide text-white transition-colors hover:bg-emergency/90 sm:w-auto sm:px-8 sm:text-2xl md:text-3xl"
          >
            {site.phoneDisplay}
          </a>
          <p class="mt-3 text-sm text-muted">{t.emergencies.tapToCall}</p>
        </div>
      </div>
    </div>
  </div>
</section>
