---
import type { Lang } from '../../i18n';
import { useTranslations } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="faq" class="section-pad bg-white" aria-labelledby="faq-title">
  <div class="container-site">
    <div class="fade-up mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent">{t.faq.eyebrow}</p>
      <h2 id="faq-title" class="mt-3 text-2xl text-primary-dark sm:text-3xl md:text-4xl">
        {t.faq.title}
      </h2>
      <p class="mt-4 text-muted">{t.faq.intro}</p>
    </div>

    <div class="fade-up mx-auto mt-12 max-w-3xl divide-y divide-border rounded-[var(--radius-card)] border border-border bg-white shadow-soft">
      {
        t.faq.items.map((item, index) => (
          <div class="faq-item">
            <h3>
              <button
                type="button"
                class="faq-trigger flex w-full items-center justify-between gap-4 px-5 py-5 text-left text-base font-semibold text-primary-dark transition-colors hover:bg-surface/80 md:px-6"
                aria-expanded="false"
                aria-controls={`faq-panel-${index}`}
                id={`faq-btn-${index}`}
              >
                <span>{item.q}</span>
                <svg
                  class="faq-chevron h-5 w-5 shrink-0 text-primary transition-transform duration-300"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                >
                  <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </h3>
            <div
              id={`faq-panel-${index}`}
              role="region"
              aria-labelledby={`faq-btn-${index}`}
              class="faq-panel hidden px-5 pb-5 text-[0.95rem] leading-relaxed text-muted md:px-6"
              hidden
            >
              <p>{item.a}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
