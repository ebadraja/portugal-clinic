---
import type { Lang } from '../../i18n';
import { useTranslations } from '../../i18n';
import { site } from '../../data/site';
import HeroTooth from '../HeroTooth.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const waUrl = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(t.hero.whatsappMessage)}`;
---

<section id="inicio" class="relative isolate min-h-[100svh] overflow-hidden bg-primary-dark text-white" aria-labelledby="hero-title">
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_20%_20%,#0e5c63_0%,transparent_55%),radial-gradient(ellipse_at_80%_10%,#126870_0%,transparent_40%),linear-gradient(165deg,#083e43_0%,#0a4a50_45%,#062f33_100%)]"></div>
    <div
      class="absolute inset-0 opacity-[0.14]"
      style="background-image: linear-gradient(rgba(255,255,255,0.07) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.07) 1px, transparent 1px); background-size: 48px 48px;"
    ></div>
    <div class="absolute -right-24 top-1/4 h-[28rem] w-[28rem] rounded-full bg-accent/10 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 right-0 h-40 bg-gradient-to-t from-primary-dark/80 to-transparent"></div>
  </div>

  <div class="container-site flex min-h-[100svh] flex-col justify-center pb-32 pt-24 sm:pb-28 sm:pt-28 md:pb-24 md:pt-32">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:gap-8 xl:gap-12">
      <div class="fade-up min-w-0">
        <p class="mb-4 text-xs font-medium uppercase tracking-[0.16em] text-accent sm:mb-5 sm:text-sm sm:tracking-[0.18em]">
          {t.hero.location}
        </p>
        <h1 id="hero-title" class="text-[1.85rem] leading-[1.15] text-white sm:text-5xl sm:leading-[1.12] md:text-[3.5rem]">
          {site.name}
        </h1>
        <p class="mt-5 max-w-2xl text-base text-white/80 sm:mt-6 sm:text-lg md:text-xl">
          {t.hero.tagline}
        </p>
        <p class="mt-3 text-sm font-medium tracking-wide text-white/60 sm:mt-4">
          {t.hero.languagesSpoken}
        </p>

        <div class="mt-8 flex w-full flex-col gap-3 sm:mt-9 sm:w-auto sm:flex-row sm:items-center">
          <a
            href={`tel:${site.phoneTel}`}
            class="inline-flex min-h-12 w-full items-center justify-center rounded-lg bg-white px-6 text-base font-semibold text-primary-dark transition-colors hover:bg-primary-soft sm:w-auto"
          >
            {t.hero.callCta} {site.phoneDisplay}
          </a>
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-12 w-full items-center justify-center rounded-lg border border-white/30 px-6 text-base font-semibold text-white transition-colors hover:border-white/60 hover:bg-white/5 sm:w-auto"
          >
            {t.hero.whatsappCta}
          </a>
        </div>

        <div class="mt-10 inline-flex w-fit max-w-full items-center gap-3 rounded-lg border border-white/15 bg-white/5 px-3.5 py-3 text-sm text-white/75 backdrop-blur-sm sm:mt-12 sm:px-4">
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
          <span class="min-w-0 leading-snug">{t.hero.hoursStrip}</span>
        </div>
      </div>

      <div class="relative mx-auto w-[min(88vw,420px)] sm:w-[min(70vw,520px)] lg:mx-0 lg:w-full lg:max-w-[560px] lg:justify-self-end">
        <HeroTooth />
      </div>
    </div>
  </div>
</section>
