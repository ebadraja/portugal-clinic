---
import type { Lang } from '../../i18n';
import { useTranslations } from '../../i18n';
import { serviceIcons } from '../../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const icons: Record<string, string> = {
  alert: `<path d="M12 9v4M12 17h.01M10.3 4.3 2.8 17.2A2 2 0 0 0 4.5 20h15a2 2 0 0 0 1.7-2.8L13.7 4.3a2 2 0 0 0-3.4 0Z" stroke-linecap="round" stroke-linejoin="round"/>`,
  restore: `<path d="M4 12a8 8 0 0 1 13.7-5.6M20 12a8 8 0 0 1-13.7 5.6M8 4v4H4M16 20v-4h4" stroke-linecap="round" stroke-linejoin="round"/>`,
  implant: `<path d="M12 3v7M9 7.5c0 1.7 1.3 3 3 3s3-1.3 3-3M10 10.5 9 21M14 10.5 15 21M8.5 21h7" stroke-linecap="round" stroke-linejoin="round"/>`,
  sparkle: `<path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1M12 8.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7Z" stroke-linecap="round"/>`,
  align: `<path d="M4 7h16M7 12h10M5 17h14" stroke-linecap="round"/>`,
  root: `<path d="M12 3c2.5 0 4.5 2 4.5 4.5S14 14 12 21C10 14 7.5 10 7.5 7.5S9.5 3 12 3Z" stroke-linejoin="round"/><path d="M12 8v4" stroke-linecap="round"/>`,
};
---

<section id="servicos" class="section-pad bg-white" aria-labelledby="servicos-title">
  <div class="container-site">
    <div class="fade-up mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent">{t.services.eyebrow}</p>
      <h2 id="servicos-title" class="mt-3 text-2xl text-primary-dark sm:text-3xl md:text-4xl">
        {t.services.title}
      </h2>
      <p class="mt-4 text-muted">{t.services.intro}</p>
    </div>

    <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.services.items.map((service, i) => (
          <li
            class:list={['fade-up', 'rounded-[var(--radius-card)] border border-border bg-white p-6 shadow-soft']}
            style={`transition-delay: ${i * 40}ms`}
          >
            <div class="mb-4 inline-flex h-11 w-11 items-center justify-center rounded-lg bg-primary-soft text-primary">
              <svg
                class="h-6 w-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                set:html={icons[serviceIcons[i]]}
                aria-hidden="true"
              />
            </div>
            <h3 class="font-display text-xl text-primary-dark">{service.title}</h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-muted">{service.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
